# PostgreSQL
POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge
POSTGRES_PORT=5434

# Backend
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HH_USER_AGENT=SkillBridge/0.1
# hh.ru vacancy API needs an application token (register app at https://dev.hh.ru)
HH_APP_TOKEN=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_SCHEDULE_ENABLED=false
# comma-separated emails that get ADMIN role (job import endpoints)
ADMIN_EMAILS=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
